# Test fixtures are byte-exact reference data. Line-ending conversion would corrupt the
# binary goldens outright and could alter the tokenizer cases, whose payloads are the
# thing under test -- so no normalisation, on any platform.
tests/fixtures/**            -text
tests/fixtures/gguf/*.bin    binary
tests/fixtures/*.bin         binary

# Sources are normalised as usual. This repository is edited on Windows and built on
# Linux, and a stray CR in a shell script or Makefile is a syntax error rather than a
# cosmetic difference.
*.c    text eol=lf
*.h    text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
Makefile text eol=lf
